---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="தொகுப்பு - பன்மியம்">
<!-- Section Header: Modern Poetry -->
<div class="text-center mb-stack-lg reveal">
<h2 class="font-headline-md text-headline-md text-primary botanical-header">புதுக்கவிதை</h2>
<p class="font-label-caps text-label-caps text-on-surface-variant opacity-70">MODERN POETRY</p>
</div>
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-section-gap">
<!-- Large Featured Card -->
<div class="md:col-span-8 group relative overflow-hidden rounded-xl h-[600px] lift-tilt reveal">
<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="A serene landscape featuring a minimalist Tamil calligraphy piece delicately placed over a soft-focus botanical background of lavender fields at dusk. The lighting is ethereal and atmospheric, with deep purple and warm cream tones blending together in a high-end magazine aesthetic. The mood is scholarly and reflective, emphasizing fine literature and modern minimalism." style="background-image: url('https://images.unsplash.com/photo-1580489944761-15a19d654956?w=400&h=400&fit=crop&q=80')">
</div>
<div class="absolute inset-0 bg-gradient-to-t from-primary-container/90 via-primary-container/20 to-transparent"></div>
<div class="absolute bottom-0 left-0 p-stack-lg text-white">
<span class="bg-on-tertiary-container/20 backdrop-blur-md px-3 py-1 rounded-full text-label-caps font-label-caps border border-on-tertiary-container/30 mb-stack-md inline-block">Featured Collection</span>
<h3 class="font-display-lg text-[40px] leading-tight mb-stack-sm">நிழலின் மொழிகள்</h3>
<p class="font-body-md text-surface-container-low max-w-lg">An exploration of contemporary metaphors in urban Tamil poetry, featuring works by emerging voices from Chennai to Toronto.</p>
</div>
</div>
<!-- Side Card 1 -->
<div class="md:col-span-4 flex flex-col gap-gutter">
<div class="flex-1 group relative overflow-hidden rounded-xl lift-tilt reveal">
<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Close-up of vintage fountain pen and handwritten Tamil script on textured parchment paper. Soft, warm directional light creates elegant shadows of olive leaves across the desk. The color palette is composed of rich creams, soft greens, and deep purples, evoking a sense of classical luxury and intellectual depth." style="background-image: url('https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=400&fit=crop&q=80')">
</div>
<div class="absolute inset-0 bg-gradient-to-t from-secondary/80 to-transparent"></div>
<div class="absolute bottom-0 left-0 p-stack-md text-white">
<h4 class="font-headline-md text-[24px]">கையெழுத்துப் பிரதிகள்</h4>
<p class="font-caption text-caption opacity-80">The Archive of Hand-written Verses</p>
</div>
</div>
<div class="flex-1 group relative overflow-hidden rounded-xl lift-tilt reveal">
<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="Abstract art piece using pastel watercolor washes of sage and lavender. Subtle gold-leaf details trace the outlines of abstract botanical shapes. The lighting is bright and airy, consistent with a refined botanical luxury aesthetic. The composition is balanced and minimalist, perfectly suited for a high-end literary journal cover." style="background-image: url('https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&h=400&fit=crop&q=80')">
</div>
<div class="absolute inset-0 bg-gradient-to-t from-tertiary/80 to-transparent"></div>
<div class="absolute bottom-0 left-0 p-stack-md text-white">
<h4 class="font-headline-md text-[24px]">வண்ணங்களின் கவிதை</h4>
<p class="font-caption text-caption opacity-80">Visual Poetics &amp; Modernism</p>
</div>
</div>
</div>
</div>
<!-- Section Header: Interviews -->
<div class="text-center mb-stack-lg reveal">
<h2 class="font-headline-md text-headline-md text-primary botanical-header">நேர்காணல்கள்</h2>
<p class="font-label-caps text-label-caps text-on-surface-variant opacity-70">CLASSICAL MUSIC &amp; ART INTERVIEWS</p>
</div>
<!-- Bento Grid for Interviews -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
<div class="bg-surface-container-low p-stack-lg rounded-xl flex flex-col justify-between border border-outline-variant/30 lift-tilt reveal">
<div>
<span class="text-primary mb-stack-md block"><span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">mic_external_on</span></span>
<h3 class="font-headline-md text-primary mb-stack-sm">இசையின் ஆதிவேர்</h3>
<p class="font-body-md text-on-surface-variant">Deep-dive interviews with veteran Carnatic musicians on the evolution of Ragas in the 21st century.</p>
</div>
<div class="mt-stack-lg pt-stack-md border-t border-outline-variant/50 flex justify-between items-center">
<span class="font-label-caps text-label-caps text-primary">12 ARTICLES</span>
<button class="material-symbols-outlined text-primary">arrow_forward</button>
</div>
</div>
<div class="group relative overflow-hidden rounded-xl h-[400px] lift-tilt reveal">
<div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105" data-alt="A portrait of a classical Indian musician in silhouette, holding a Veena against a softly lit background of botanical leaf patterns. The lighting is dramatic yet soft, highlighting the craftsmanship of the instrument. The color palette centers on deep purples and warm ambers, evoking a sense of tradition meeting modern editorial design." style="background-image: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=1200&h=675&fit=crop&q=80')">
</div>
<div class="absolute inset-0 bg-primary/40 backdrop-blur-[2px]"></div>
<div class="absolute inset-0 flex flex-col items-center justify-center text-white text-center p-stack-md">
<h3 class="font-display-lg text-[32px] mb-2">யாழ் மீட்டும் நொடிகள்</h3>
<p class="font-label-caps text-label-caps tracking-widest border-t border-white/30 pt-2">THE VEENA CHRONICLES</p>
</div>
</div>
<div class="bg-on-tertiary-container/10 p-stack-lg rounded-xl flex flex-col justify-between border border-on-tertiary-container/20 lift-tilt reveal">
<div>
<span class="text-on-tertiary-fixed-variant mb-stack-md block"><span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">theater_comedy</span></span>
<h3 class="font-headline-md text-primary mb-stack-sm">மேடைப் பேச்சு</h3>
<p class="font-body-md text-on-surface-variant">The untold stories of Tamil theater artists who bridged the gap between folk drama and modern stagecraft.</p>
</div>
<div class="mt-stack-lg pt-stack-md border-t border-outline-variant/50 flex justify-between items-center">
<span class="font-label-caps text-label-caps text-primary">08 ARTICLES</span>
<button class="material-symbols-outlined text-primary">arrow_forward</button>
</div>
</div>
</div>
<!-- Custom CTA Section -->
<div class="mt-section-gap relative p-section-gap rounded-[40px] overflow-hidden text-center reveal">

<div class="relative z-10 max-w-2xl mx-auto">
<h2 class="font-display-lg text-display-lg text-primary mb-stack-md">உங்கள் தேடல் இங்கே தொடங்கட்டும்</h2>
<p class="font-body-lg text-on-surface-variant mb-stack-lg">Join our newsletter to receive the most exquisite Tamil literature and arts curated weekly.</p>
<div class="flex flex-col md:flex-row gap-stack-sm justify-center">
<input class="px-6 py-4 rounded-full border-none ring-1 ring-outline-variant focus:ring-2 focus:ring-primary bg-surface/80 backdrop-blur-md w-full md:w-80" placeholder="Email address" type="email"/>
<button class="bg-primary text-on-primary px-8 py-4 rounded-full font-label-caps text-label-caps hover:shadow-lg hover:-translate-y-1 transition-all duration-300">Subscribe Now</button>
</div>
</div>
</div>
</BaseLayout>

<script is:inline>
// Scroll Reveal Implementation
        const observerOptions = {
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Smooth interaction for buttons
        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mousedown', () => el.classList.add('scale-95'));
            el.addEventListener('mouseup', () => el.classList.remove('scale-95'));
            el.addEventListener('mouseleave', () => el.classList.remove('scale-95'));
        });
</script>
