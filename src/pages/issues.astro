---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="இதழ்கள் - பன்மியம்">
<!-- Header Section -->
<header class="mb-section-gap pt-12 md:pt-24 text-center md:text-left reveal-up">
<span class="font-label-caps text-label-caps text-secondary mb-4 block">THE ARCHIVE</span>
<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface max-w-3xl leading-none">
                இதழ்கள் <br/> <span class="text-primary italic">The Printed Word.</span>
</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant mt-8 max-w-2xl">
                Explore our curated collection of quarterly issues. Each edition is a journey through modern Tamil literature, art, and intellectual discourse.
            </p>
</header>
<!-- Issues Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter mb-section-gap">
<!-- Issue 1 -->
<article class="lift-tilt reveal-up group">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-sm mb-6 shadow-[0_10px_30px_rgba(105,36,117,0.04)]">
<img class="w-full h-full object-cover" data-alt="A premium magazine cover for a Tamil literary journal titled Panmiyam. The cover art features a sophisticated abstract oil painting in shades of deep purple and sage green. Minimalist typography in Noto Serif Tamil font. The lighting is soft and artistic, mimicking a physical high-end editorial product sitting in a bright airy studio." src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=800&h=1000&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>
<div class="space-y-3">
<div class="flex justify-between items-center">
<span class="font-label-caps text-[10px] tracking-widest text-secondary uppercase">Issue #12 • Winter 2024</span>
<span class="font-label-caps text-[10px] bg-on-tertiary-container/10 text-on-tertiary-container px-2 py-0.5 rounded-full">New Release</span>
</div>
<h3 class="font-headline-md text-2xl text-on-surface">நிழல் மற்றும் நிஜம்</h3>
<p class="font-body-md text-on-surface-variant line-clamp-2">A deep dive into the dualities of modern existence through contemporary poetry and long-form essays.</p>
<div class="flex gap-4 pt-4">
<button class="bg-primary text-on-primary font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm active:scale-95 transition-transform uppercase tracking-wider">Buy Issue</button>
<button class="border border-outline-variant text-on-surface-variant font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm hover:bg-surface-variant active:scale-95 transition-transform uppercase tracking-wider">Read Online</button>
</div>
</div>
</article>
<!-- Issue 2 -->
<article class="lift-tilt reveal-up group" style="transition-delay: 100ms;">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-sm mb-6 shadow-[0_10px_30px_rgba(105,36,117,0.04)]">
<img class="w-full h-full object-cover" data-alt="A scholarly magazine cover with botanical line art of a jasmine flower, rendered in delicate gold and deep plum lines. The background is a warm cream texture. Minimalist Tamil typography. The overall aesthetic is refined botanical luxury, clean and airy for a prestigious literary publication." src="https://images.unsplash.com/photo-1495446815901-a7297e633e8d?w=800&h=1000&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>
<div class="space-y-3">
<div class="flex justify-between items-center">
<span class="font-label-caps text-[10px] tracking-widest text-secondary uppercase">Issue #11 • Autumn 2023</span>
</div>
<h3 class="font-headline-md text-2xl text-on-surface">மண் வாசம்</h3>
<p class="font-body-md text-on-surface-variant line-clamp-2">The essence of roots and migration. Featuring an exclusive interview with leading diaspora novelists.</p>
<div class="flex gap-4 pt-4">
<button class="bg-primary text-on-primary font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm active:scale-95 transition-transform uppercase tracking-wider">Buy Issue</button>
<button class="border border-outline-variant text-on-surface-variant font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm hover:bg-surface-variant active:scale-95 transition-transform uppercase tracking-wider">Read Online</button>
</div>
</div>
</article>
<!-- Issue 3 -->
<article class="lift-tilt reveal-up group" style="transition-delay: 200ms;">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-sm mb-6 shadow-[0_10px_30px_rgba(105,36,117,0.04)]">
<img class="w-full h-full object-cover" data-alt="Magazine cover design featuring a striking monochromatic architectural photograph of a traditional South Indian temple pillar with modern lighting. Elegant serif typography. High contrast, scholarly and modern aesthetic. Cream and deep charcoal color palette with subtle lavender accents." src="https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=800&h=1000&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>
<div class="space-y-3">
<div class="flex justify-between items-center">
<span class="font-label-caps text-[10px] tracking-widest text-secondary uppercase">Issue #10 • Summer 2023</span>
</div>
<h3 class="font-headline-md text-2xl text-on-surface">காலத்தின் சுவடுகள்</h3>
<p class="font-body-md text-on-surface-variant line-clamp-2">Tracing the evolution of classical Tamil rhythms in modern-day digital literature.</p>
<div class="flex gap-4 pt-4">
<button class="bg-primary text-on-primary font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm active:scale-95 transition-transform uppercase tracking-wider">Buy Issue</button>
<button class="border border-outline-variant text-on-surface-variant font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm hover:bg-surface-variant active:scale-95 transition-transform uppercase tracking-wider">Read Online</button>
</div>
</div>
</article>
<!-- Issue 4 -->
<article class="lift-tilt reveal-up group">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-sm mb-6 shadow-[0_10px_30px_rgba(105,36,117,0.04)]">
<img class="w-full h-full object-cover" data-alt="A literary magazine cover displaying a minimal watercolor splash in sage green and earthy brown on a textured off-white paper background. Tamil script is centered beautifully with generous white space. Refined, scholarly, and serene aesthetic for a premium botanical luxury brand." src="https://images.unsplash.com/photo-1455390582262-044cdead277a?w=800&h=800&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>
<div class="space-y-3">
<div class="flex justify-between items-center">
<span class="font-label-caps text-[10px] tracking-widest text-secondary uppercase">Issue #09 • Spring 2023</span>
</div>
<h3 class="font-headline-md text-2xl text-on-surface">புதிய வானம்</h3>
<p class="font-body-md text-on-surface-variant line-clamp-2">Exploring the frontiers of Tamil science fiction and speculative futures.</p>
<div class="flex gap-4 pt-4">
<button class="bg-primary text-on-primary font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm active:scale-95 transition-transform uppercase tracking-wider">Buy Issue</button>
<button class="border border-outline-variant text-on-surface-variant font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm hover:bg-surface-variant active:scale-95 transition-transform uppercase tracking-wider">Read Online</button>
</div>
</div>
</article>
<!-- Issue 5 -->
<article class="lift-tilt reveal-up group" style="transition-delay: 100ms;">
<div class="aspect-[3/4] relative overflow-hidden bg-surface-container-high rounded-sm mb-6 shadow-[0_10px_30px_rgba(105,36,117,0.04)]">
<img class="w-full h-full object-cover" data-alt="Editorial magazine cover featuring a macro photograph of ancient ink on palm leaf manuscripts. Dramatic, soft focus, high-end scholarly lighting. The color palette is rich browns, ambers, and deep purples. Professional literary journal aesthetic with elegant typography." src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=800&h=1000&fit=crop&q=80"/>
<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>
<div class="space-y-3">
<div class="flex justify-between items-center">
<span class="font-label-caps text-[10px] tracking-widest text-secondary uppercase">Issue #08 • Winter 2022</span>
</div>
<h3 class="font-headline-md text-2xl text-on-surface">சுவடுகள்</h3>
<p class="font-body-md text-on-surface-variant line-clamp-2">A commemorative edition celebrating 50 years of experimental Tamil short stories.</p>
<div class="flex gap-4 pt-4">
<button class="bg-primary text-on-primary font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm active:scale-95 transition-transform uppercase tracking-wider">Buy Issue</button>
<button class="border border-outline-variant text-on-surface-variant font-label-caps text-[11px] px-6 py-3 flex-1 rounded-sm hover:bg-surface-variant active:scale-95 transition-transform uppercase tracking-wider">Read Online</button>
</div>
</div>
</article>
<!-- Newsletter Card -->
<div class="bg-primary-container text-on-primary-container p-gutter rounded-sm flex flex-col justify-between reveal-up" style="transition-delay: 200ms;">
<div>
<span class="font-label-caps text-label-caps text-primary-fixed-dim block mb-4">NEWSLETTER</span>
<h3 class="font-headline-md text-headline-md mb-4 text-white">Never miss an issue.</h3>
<p class="font-body-md opacity-80 mb-8">Join 5,000+ readers and receive exclusive essays, early access to new issues, and literary news directly in your inbox.</p>
</div>
<form class="space-y-4">
<input class="w-full bg-transparent border-b border-on-primary-container/30 py-3 focus:border-primary-fixed-dim focus:ring-0 outline-none placeholder:text-on-primary-container/50" placeholder="Your email address" type="email"/>
<button class="w-full bg-primary-fixed-dim text-on-primary-fixed font-label-caps text-label-caps py-4 rounded-sm hover:bg-white transition-colors">Join the Circle</button>
</form>
</div>
</div>
<!-- Subscription Callout -->
<section class="reveal-up py-section-gap border-y border-outline-variant/30 flex flex-col items-center text-center">
<h2 class="font-display-lg text-4xl md:text-5xl text-on-surface mb-6">ஆண்டு சந்தா <br class="md:hidden"/> <span class="text-primary italic">Yearly Subscription</span></h2>
<p class="font-body-lg text-on-surface-variant max-w-2xl mb-10">Get four quarterly issues delivered to your door and full digital access to our entire archive. Support the future of Tamil letters.</p>
<div class="flex flex-col md:flex-row gap-6">
<div class="bg-surface-container p-stack-lg rounded-sm border border-outline-variant/20 w-80 text-left">
<span class="font-label-caps text-[10px] text-secondary tracking-widest uppercase mb-2 block">Standard</span>
<div class="text-3xl font-bold text-primary mb-4">₹1200 <span class="text-sm font-normal text-on-surface-variant">/ Year</span></div>
<ul class="space-y-3 mb-8">
<li class="flex items-center gap-2 text-sm"><span class="material-symbols-outlined text-xs text-on-tertiary-container">check_circle</span> 4 Physical Issues</li>
<li class="flex items-center gap-2 text-sm"><span class="material-symbols-outlined text-xs text-on-tertiary-container">check_circle</span> Digital PDF Access</li>
</ul>
<button class="w-full border border-primary text-primary py-3 font-label-caps text-[11px] rounded-sm hover:bg-primary hover:text-white transition-all uppercase tracking-widest">Select</button>
</div>
<div class="bg-primary text-on-primary p-stack-lg rounded-sm shadow-xl w-80 text-left relative scale-105">
<span class="absolute -top-3 right-4 bg-on-tertiary-container text-white text-[9px] px-2 py-1 rounded-full font-bold uppercase tracking-tighter">Recommended</span>
<span class="font-label-caps text-[10px] text-primary-fixed-dim tracking-widest uppercase mb-2 block">Premium</span>
<div class="text-3xl font-bold text-white mb-4">₹2500 <span class="text-sm font-normal opacity-70">/ Year</span></div>
<ul class="space-y-3 mb-8">
<li class="flex items-center gap-2 text-sm"><span class="material-symbols-outlined text-xs">check_circle</span> 4 Physical Issues</li>
<li class="flex items-center gap-2 text-sm"><span class="material-symbols-outlined text-xs">check_circle</span> Full Digital Archive Access</li>
<li class="flex items-center gap-2 text-sm"><span class="material-symbols-outlined text-xs">check_circle</span> Limited Edition Art Prints</li>
</ul>
<button class="w-full bg-white text-primary py-3 font-label-caps text-[11px] rounded-sm hover:bg-primary-fixed-dim hover:text-on-primary-fixed transition-all uppercase tracking-widest">Select</button>
</div>
</div>
</section>
</BaseLayout>

<script is:inline>
// Scroll Reveal Animation
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal-up').forEach(el => observer.observe(el));

        // Smooth Scroll to Top
        document.querySelector('button.bg-surface-container-high')?.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
</script>
