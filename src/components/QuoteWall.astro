---
import { getCollection } from 'astro:content';

const interviews = await getCollection('interviews');

// ஒவ்வொரு interview-இன் pullQuotes-ஐயும் தட்டையாக்கி single list ஆக்குதல்
const allQuotes = interviews.flatMap((entry) =>
  entry.data.pullQuotes.map((q) => ({
    quote: q,
    name: entry.data.authorName,
    role: entry.data.authorRole || '',
    slug: entry.slug,
  }))
);

// எதுவும் இல்லைனா, placeholder quotes காட்டு (content இன்னும் இல்லாத போது demo-க்கு)
const fallback = [
  { quote: "எழுத்து என்பது அமைதியின் இன்னொரு குரல்.", name: "எழுத்தாளர் பெயர் (placeholder)", role: "கவிஞர்", slug: null },
  { quote: "மொழி வாழும்போது மட்டுமே நினைவுகள் வாழ்கின்றன.", name: "எழுத்தாளர் பெயர் (placeholder)", role: "நாவலாசிரியர்", slug: null },
  { quote: "ஒவ்வொரு கதையும் ஒரு கண்ணாடி — நம்மைத் திருப்பிக் காட்டுகிறது.", name: "எழுத்தாளர் பெயர் (placeholder)", role: "சிறுகதை எழுத்தாளர்", slug: null },
];

const quotes = allQuotes.length > 0 ? allQuotes : fallback;
// seamless loop-க்காக இரு தடவை
const track = [...quotes, ...quotes];
---
<div class="pm-quote-col reveal active">
  <div class="pm-quote-track">
    {track.map((item) => (
      item.slug ? (
        <a href={`/interview/${item.slug}`} class="pm-qcard no-underline">
          <span class="pm-qmark">"</span>
          <p class="pm-qtext">{item.quote}</p>
          <div class="pm-qattr">
            <div class="pm-qname">{item.name}</div>
            <div class="pm-qrole">{item.role}</div>
            <span class="pm-readmore">முழு நேர்காணலைப் படிக்க <span class="material-symbols-outlined">north_east</span></span>
          </div>
        </a>
      ) : (
        <div class="pm-qcard">
          <span class="pm-qmark">"</span>
          <p class="pm-qtext">{item.quote}</p>
          <div class="pm-qattr">
            <div class="pm-qname">{item.name}</div>
            <div class="pm-qrole">{item.role}</div>
          </div>
        </div>
      )
    ))}
  </div>
  {allQuotes.length === 0 && (
    <p class="font-caption text-caption text-on-surface-variant mt-3">Placeholder content — நேர்காணல்கள் CMS மூலம் சேர்க்கும்போது இங்கு தானாகப் புதுப்பிக்கப்படும்</p>
  )}
</div>

<style>
  /* ஹீரோ கார்டு அளவிலான (aspect 4:5) நிலைக்குத்து நகரும் மேற்கோள் column */
  .pm-quote-col {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
  }
  .pm-quote-track {
    position: absolute;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: pmScrollUp 26s linear infinite;
  }
  .pm-quote-track:hover { animation-play-state: paused; }
  @keyframes pmScrollUp {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  .pm-qcard {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #FFFFFF;
    border: 1px solid #E3D8C6;
    border-radius: 16px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 10px 28px -16px rgba(105, 36, 117, 0.18);
    transition: border-color .3s ease, box-shadow .3s ease;
  }
  .pm-qcard::before {
    content: ""; position: absolute; top: 26px; left: 0; width: 4px; height: 32px;
    background: #82AB7D; border-radius: 0 4px 4px 0;
  }
  a.pm-qcard:hover { border-color: rgba(105, 36, 117, 0.4); box-shadow: 0 22px 44px -18px rgba(105, 36, 117, 0.3); }
  .pm-qmark {
    font-family: 'Bodoni Moda', serif; font-style: italic; font-size: 44px;
    color: #A47DAB; opacity: .9; line-height: .4; display: block; margin-bottom: 16px;
  }
  .pm-qtext {
    font-family: 'Noto Serif Tamil', serif; font-weight: 500; font-size: 19px;
    line-height: 1.65; color: #2A2130;
  }
  .pm-qattr { border-top: 1px solid #E3D8C6; padding-top: 14px; margin-top: 14px; }
  .pm-qname { font-family: 'Manrope', sans-serif; font-size: 14px; color: #692475; font-weight: 600; }
  .pm-qrole { font-family: 'Manrope', sans-serif; font-size: 12px; color: #6A6B4E; margin-top: 2px; }
  .pm-readmore {
    display: flex; align-items: center; gap: 6px; margin-top: 12px;
    font-family: 'Manrope', sans-serif; font-size: 11px; letter-spacing: .05em; text-transform: uppercase;
    color: #82AB7D; font-weight: 600; opacity: 0; transform: translateY(4px);
    transition: opacity .3s ease, transform .3s ease;
  }
  .pm-readmore .material-symbols-outlined { font-size: 16px; }
  a.pm-qcard:hover .pm-readmore { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .pm-quote-track { animation: none !important; } }
  @media (max-width: 768px) {
    .pm-quote-col { aspect-ratio: 3 / 4; }
  }
</style>
